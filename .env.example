# PostgreSQL is the runtime warehouse. Azure SQL and MySQL DDL live in sql/.
DATABASE_URL=postgresql://airbnb:airbnb@localhost:5432/airbnb

# local writes under DATA_DIR. azure streams the same keys to Blob Storage.
STORAGE_BACKEND=local
DATA_DIR=./data

# Required only when STORAGE_BACKEND=azure.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=airbnb-raw

# One in-flight transfer per file in a city snapshot.
DOWNLOAD_CONCURRENCY=7
REUSE_DOWNLOADS=true

MARKETS_FILE=config/markets.json
